{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "claude-blackbox",
  "version": "0.1.0",
  "identifier": "com.fantomc0der.claude-blackbox",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "bun scripts/build-sidecar.ts",
    "beforeBuildCommand": "bun scripts/build-sidecar.ts"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/claude-blackbox-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
