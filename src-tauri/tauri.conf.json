{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "claude-blackbox",
  "version": "0.5.2",
  "identifier": "com.fantomc0der.claude-blackbox",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "bun scripts/build-sidecar.ts",
    "beforeBuildCommand": "bun scripts/build-sidecar.ts"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/claude-blackbox-server"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5QjJEMzBBMjIyOEEzRDEKUldUUm95Z2lDdE95R1ZBMzduNXZ4NHNWaC8xMWZtcHVuY3JvQ0ZYRGxzWXkrUDgyR21hNUZxZUwK",
      "endpoints": [
        "https://github.com/fantomc0der/claude-blackbox/releases/latest/download/latest.json"
      ]
    }
  }
}
